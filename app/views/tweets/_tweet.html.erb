<div class="content_post" style="<% if tweet.image.attached? %>background-image: url(<%= url_for(tweet.image.variant(resize_to_limit: [600, 600])) %>);<% end %>">

  <div class="more">
    <span><%= image_tag 'arrow_top.png' %></span>
    <ul class="more_list">
      <li>
        <%= link_to '詳細', tweet_path(tweet.id) %>
      </li>
    <% if user_signed_in? && current_user.id == tweet.user_id %>
      <li>
        <%= link_to '編集', edit_tweet_path(tweet.id) %>
      </li>
      <li>
        <%= link_to '削除', tweet_path(tweet.id), data: { turbo_method: :delete } %>
      </li>
    <% end %>
    </ul>
  </div>

  <p><%= tweet.text %></p>
  <span class="name">
    <a href="/users/<%= tweet.user.id %>">
      <span>投稿者</span><%= tweet.user.nickname %>               
    </a >
  </span>


<% if user_signed_in? %>
<% if tweet.likes.exists?(user: current_user) %>
  <%= button_to '💔 いいね解除', tweet_likes_path(tweet.id), method: :delete, class: "like-button" %>
<% else %>
  <%= button_to '❤️ いいね', tweet_likes_path(tweet.id), method: :post, class: "like-button" %>
<% end %>
<span class="like-count"><%= tweet.likes.count %>件のいいね</span>
<% end %>

</div>
